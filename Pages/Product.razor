@page "/products"
@inject ECommerceShowcase.Data.ProductService ProductService

<h3 class="text-2xl font-bold mb-4">Our Products</h3>

@if (products == null || products.Count == 0)
{
        <p>Loading products...</p>
}
else
{
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
        @foreach (var product in products)
        {
                    <div class="border rounded-lg shadow p-4 flex flex-col items-center">
                        <img src="@product.ImageUrl" alt="@product.Name" class="w-32 h-32 object-cover mb-2" />
                        <h4 class="font-semibold text-lg">@product.Name</h4>
                        <p class="text-gray-600 mt-1">$@product.Price</p>
                        <button class="mt-3 bg-blue-500 text-white px-4 py-2 rounded hover:bg-blue-600">
                            Add to Cart
                        </button>
                    </div>
        }
        </div>
}

@code {
    private List<ECommerceShowcase.Models.Product> products = new();

    protected override void OnInitialized()
    {
        products = ProductService.GetProducts().ToList();
    }
}
